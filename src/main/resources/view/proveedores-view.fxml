<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.crudpersona.ui.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ResponsiveSplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.crudpersona.controller.RPLCProveedoresController"
      prefWidth="1280" prefHeight="720" styleClass="view-root">

    <VBox spacing="16" HBox.hgrow="ALWAYS">
        <VBox spacing="14" styleClass="tarjeta, module-header">
            <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
            <ResponsiveFlowPane alignment="CENTER_LEFT">
                <StackPane styleClass="header-icon"><FontIcon iconLiteral="fth-users" iconSize="21"/></StackPane>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Proveedores" styleClass="title-4"/>
                    <Label text="Administra proveedores, contactos, estados y compras DUA vinculadas." styleClass="header-subtitle"/>
                </VBox>
                <TextField fx:id="txtBuscar" promptText="Buscar proveedor, RUC, contacto o teléfono" prefWidth="330" onAction="#onBuscar"/>
                <ComboBox fx:id="cmbEstado" prefWidth="140" onAction="#onBuscar"/>
                <Button text="Buscar" onAction="#onBuscar" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-search" iconSize="14"/></graphic>
                </Button>
                <Button text="Nuevo proveedor" onAction="#onNuevo" styleClass="btn-primario">
                    <graphic><FontIcon iconLiteral="fth-plus" iconSize="14"/></graphic>
                </Button>
            </ResponsiveFlowPane>
        </VBox>

        <VBox spacing="12" styleClass="tarjeta" VBox.vgrow="ALWAYS">
            <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
            <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="240"/>
                    <TableColumn fx:id="colRuc" text="RUC" prefWidth="120"/>
                    <TableColumn fx:id="colContacto" text="Contacto" prefWidth="150"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190"/>
                    <TableColumn fx:id="colUltimaCompra" text="Última compra" prefWidth="130"/>
                    <TableColumn fx:id="colTotalComprado" text="Total comprado" prefWidth="130"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>

            <ResponsiveFlowPane alignment="CENTER_RIGHT" styleClass="action-strip">
                <Button text="Editar" onAction="#onEditar" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-edit-2" iconSize="14"/></graphic>
                </Button>
                <Button text="Activar / desactivar" onAction="#onCambiarEstado" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-toggle-left" iconSize="14"/></graphic>
                </Button>
                <Button text="Marcar observado" onAction="#onObservar" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-alert-circle" iconSize="14"/></graphic>
                </Button>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="14"/></graphic>
                </Button>
            </ResponsiveFlowPane>
        </VBox>
    </VBox>

    <VBox spacing="14" prefWidth="360" styleClass="tarjeta, detail-panel">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <StackPane styleClass="header-icon"><FontIcon iconLiteral="fth-clipboard" iconSize="18"/></StackPane>
            <Label text="Detalle proveedor" styleClass="title-4"/>
        </HBox>

        <GridPane hgap="10" vgap="10">
            <Label text="Razón social" styleClass="text-subtle" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblRazon" text="-" wrapText="true" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="RUC" styleClass="text-subtle" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblRuc" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Contacto" styleClass="text-subtle" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblContacto" text="-" wrapText="true" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Teléfono" styleClass="text-subtle" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblTelefono" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Correo" styleClass="text-subtle" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblCorreo" text="-" wrapText="true" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Estado" styleClass="text-subtle" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="lblEstado" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Compras" styleClass="text-subtle" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="lblCompras" text="-" wrapText="true" style="-fx-font-weight: bold;" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <Separator/>
        <Label text="Últimas compras DUA" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="txtHistorial" editable="false" wrapText="true" prefHeight="220" styleClass="report-area"/>
    </VBox>
</ResponsiveSplitPane>
