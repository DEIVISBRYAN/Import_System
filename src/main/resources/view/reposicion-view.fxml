<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import com.ejemplo.crudpersona.ui.ResponsiveFlowPane?>
<?import com.ejemplo.crudpersona.ui.ExportarMenu?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.crudpersona.controller.RPLCReposicionController"
      prefWidth="1100" minHeight="-Infinity" spacing="18" alignment="TOP_LEFT" fillWidth="true"
      styleClass="view-root, replenishment-view">
    <VBox spacing="24" styleClass="replenishment-surface">
        <ResponsiveFlowPane alignment="CENTER_LEFT" hgap="20" vgap="16" styleClass="replenishment-heading">
            <TextFlow minWidth="0" prefWidth="460" maxWidth="460" styleClass="replenishment-summary">
                <Text fx:id="txtUrgentes" text="0 productos" styleClass="replenishment-urgent"/>
                <Text fx:id="txtResumen" text=" hay que pedirlos hoy para no quedarse sin stock." styleClass="replenishment-summary-text"/>
            </TextFlow>
            <Button fx:id="btnGrafico" text="Ver gráfico de stock crítico" onAction="#onVerGrafico" styleClass="replenishment-chart-button">
                <graphic><FontIcon iconLiteral="fth-bar-chart-2" iconSize="16"/></graphic>
            </Button>
        </ResponsiveFlowPane>
        <TableView fx:id="tablaReposicion" fixedCellSize="56" styleClass="tabla, replenishment-table, fit-columns">
            <placeholder><Label text="No hay productos en este filtro." styleClass="text-subtle"/></placeholder>
            <columns>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="230" minWidth="160" styleClass="replenishment-product-column"/>
                <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="170" minWidth="128"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="72" minWidth="64" styleClass="replenishment-quantity-column"/>
                <TableColumn fx:id="colVentasDia" text="Vende/día" prefWidth="95" minWidth="88" styleClass="replenishment-number-column"/>
                <TableColumn fx:id="colEntrega" text="Entrega (d)" prefWidth="96" minWidth="90" styleClass="replenishment-number-column"/>
                <TableColumn fx:id="colPuntoReposicion" text="Punto repos." prefWidth="112" minWidth="104" styleClass="replenishment-number-column"/>
                <TableColumn fx:id="colPedir" text="Pedir" prefWidth="74" minWidth="64" styleClass="replenishment-quantity-column"/>
                <TableColumn fx:id="colCuando" text="Cuándo" prefWidth="152" minWidth="144" styleClass="replenishment-state-column"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        </TableView>
    </VBox>

    <ResponsiveFlowPane alignment="CENTER_LEFT" hgap="10" vgap="10" styleClass="replenishment-actions">
        <ExportarMenu fx:id="exportarReporte"/>
        <ComboBox fx:id="cmbFiltro" prefWidth="150" onAction="#onFiltrar">
            <tooltip><Tooltip text="Filtrar por estado de reposición"/></tooltip>
        </ComboBox>
        <Button onAction="#onActualizar" styleClass="btn-icono">
            <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="16"/></graphic>
            <tooltip><Tooltip text="Actualizar reposición"/></tooltip>
        </Button>
        <Button fx:id="btnAsignarProveedor" text="Asignar proveedor" onAction="#onAsignarProveedor" styleClass="btn-primario">
            <graphic><FontIcon iconLiteral="fth-users" iconSize="15"/></graphic>
        </Button>
        <Button fx:id="btnGenerarPedido" text="Generar pedido" onAction="#onGenerarPedido" styleClass="btn-secundario">
            <graphic><FontIcon iconLiteral="fth-shopping-bag" iconSize="15"/></graphic>
        </Button>
        <Button fx:id="btnPedidosHoy" text="Pedidos de hoy" onAction="#onGenerarPedidoHoy" styleClass="btn-secundario">
            <graphic><FontIcon iconLiteral="fth-send" iconSize="15"/></graphic>
        </Button>
        <Button fx:id="btnVerPedidos" text="Pedidos" onAction="#onVerPedidos" styleClass="btn-secundario">
            <graphic><FontIcon iconLiteral="fth-folder" iconSize="15"/></graphic>
        </Button>
        <MenuButton styleClass="btn-secundario">
            <graphic><FontIcon iconLiteral="fth-more-horizontal" iconSize="16"/></graphic>
            <tooltip><Tooltip text="Parámetros y reporte de reposición"/></tooltip>
            <items>
                <MenuItem fx:id="menuEditarParametros" text="Editar parámetros" onAction="#onEditarParametros">
                    <graphic><FontIcon iconLiteral="fth-sliders" iconSize="15"/></graphic>
                </MenuItem>
                <MenuItem text="Reporte de reposición" onAction="#onReporte">
                    <graphic><FontIcon iconLiteral="fth-file-text" iconSize="15"/></graphic>
                </MenuItem>
            </items>
        </MenuButton>
    </ResponsiveFlowPane>

    <TitledPane text="Detalle de cálculo" expanded="false" animated="false" styleClass="replenishment-details">
        <content>
            <VBox spacing="12" styleClass="replenishment-detail-content">
                <Label fx:id="lblDetalleProducto" text="-" wrapText="true" styleClass="replenishment-detail-product"/>
                <Label fx:id="lblDetalleFormula" text="-" wrapText="true" styleClass="text-subtle"/>
                <ResponsiveFlowPane>
                    <Label text="Proveedor" styleClass="text-subtle"/>
                    <Label fx:id="lblDetalleProveedor" text="-" wrapText="true"/>
                </ResponsiveFlowPane>
                <ResponsiveFlowPane>
                    <Label text="Costo estimado" styleClass="text-subtle"/>
                    <Label fx:id="lblDetalleCosto" text="-" wrapText="true"/>
                    <Label fx:id="lblDetalleEstado" text="-"/>
                </ResponsiveFlowPane>
            </VBox>
        </content>
    </TitledPane>
</VBox>
