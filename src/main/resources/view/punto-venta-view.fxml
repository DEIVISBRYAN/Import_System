<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.crudpersona.ui.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.crudpersona.controller.ERQZPuntoVentaController"
      fx:id="vistaVenta"
      spacing="20" prefWidth="1280" prefHeight="720" styleClass="view-root">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="tarjeta, slim-banner">
        <FontIcon iconLiteral="fth-database" iconSize="18" styleClass="color-acento"/>
        <Label text="Base central PostgreSQL:" styleClass="text-subtle"/>
        <Label fx:id="lblResumenBase" text="Productos registrados" style="-fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="22" styleClass="tarjeta, workspace-card" VBox.vgrow="ALWAYS">
        <padding><Insets top="28" right="28" bottom="18" left="28"/></padding>

        <ResponsiveFlowPane alignment="CENTER_LEFT">
            <StackPane styleClass="header-icon"><FontIcon iconLiteral="fth-shopping-cart" iconSize="22"/></StackPane>
            <VBox spacing="2" prefWidth="320">
                <Label text="Nueva venta" styleClass="title-3"/>
                <Label text="Busca productos, identifica cliente y cobra con el comprobante correcto." styleClass="header-subtitle"/>
            </VBox>
            <Label fx:id="lblEstadoCaja" text="Caja" styleClass="chip-alerta"/>
            <HBox alignment="CENTER" spacing="12" styleClass="chip-info">
                <Label text="Dólar"/>
                <Label fx:id="lblCambioVenta" text="3.75" style="-fx-font-weight: bold;"/>
            </HBox>
        </ResponsiveFlowPane>

        <Separator/>

        <VBox spacing="12" styleClass="action-strip">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="txtEscaner" promptText="Código de barras, SKU o producto" minWidth="0" HBox.hgrow="ALWAYS" onAction="#onEscanearEnter">
                    <tooltip><Tooltip text="Código manual o lector USB tipo teclado. Sufijo Enter o Tab. F8 vuelve al código."/></tooltip>
                </TextField>
                <ToggleButton fx:id="btnModoLector" text="Lector" onAction="#onModoLector" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-maximize" iconSize="16"/></graphic>
                    <tooltip><Tooltip text="Modo lector: coincidencia exacta por código de barras o SKU"/></tooltip>
                </ToggleButton>
                <Button text="Agregar" onAction="#onAgregarBusqueda" styleClass="btn-secundario"/>
            </HBox>
            <ResponsiveFlowPane fx:id="boxBotonesRapidos"/>
        </VBox>

        <ResponsiveFlowPane alignment="CENTER_LEFT" styleClass="action-strip">
            <TextField fx:id="txtClienteDocumento" promptText="DNI / RUC" prefWidth="180"/>
            <TextField fx:id="txtClienteNombre" promptText="Cliente mostrador" HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblStockAviso" text="" styleClass="chip-alerta" visible="false" managed="false"/>
        </ResponsiveFlowPane>

        <TableView fx:id="tablaVenta" VBox.vgrow="ALWAYS" styleClass="tabla">
            <columns>
                <TableColumn fx:id="colSku" text="SKU" prefWidth="90"/>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="115"/>
                <TableColumn fx:id="colDescripcion" text="Producto y lote" prefWidth="430"/>
                <TableColumn fx:id="colLote" text="Lote" prefWidth="100"/>
                <TableColumn fx:id="colCantidad" text="Cant." prefWidth="130"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="130"/>
                <TableColumn fx:id="colSubtotal" text="Importe" prefWidth="130"/>
                <TableColumn fx:id="colAccion" text="" prefWidth="90"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="total-panel">
            <VBox alignment="CENTER_RIGHT" spacing="6">
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="Base" styleClass="text-subtle"/>
                    <Label fx:id="lblSubtotal" text="S/ 0.00" styleClass="text-subtle"/>
                    <Label text="· IGV 18%" styleClass="text-subtle"/>
                    <Label fx:id="lblIgv" text="S/ 0.00" styleClass="text-subtle"/>
                </HBox>
                <Label fx:id="lblTotalUSD" text="US$ 0.00" managed="false" visible="false"/>
                <Label fx:id="lblTotalPEN" text="S/ 0.00" styleClass="total-amount"/>
            </VBox>
        </HBox>

        <Separator/>

        <ResponsiveFlowPane alignment="CENTER_LEFT">
            <RadioButton fx:id="rbEfectivo" text="Efectivo" selected="true" styleClass="btn-secundario"/>
            <RadioButton fx:id="rbYapePlin" text="Yape / Plin" styleClass="btn-secundario"/>
            <RadioButton fx:id="rbTarjeta" text="Tarjeta" styleClass="btn-secundario"/>
            <RadioButton fx:id="rbMixto" text="Mixto" styleClass="btn-secundario"/>
            <Region HBox.hgrow="ALWAYS"/>
            <RadioButton fx:id="rbBoleta" text="Boleta (DNI)" selected="true" styleClass="btn-secundario"/>
            <RadioButton fx:id="rbFactura" text="Factura (RUC)" styleClass="btn-secundario"/>
            <Button fx:id="btnCobrar" text="Pagar y guardar" onAction="#onCobrar" styleClass="btn-primario" prefHeight="46" prefWidth="180"/>
        </ResponsiveFlowPane>
        <Label text="Los precios quedan congelados al cobrar." styleClass="text-subtle"/>
    </VBox>
</VBox>
