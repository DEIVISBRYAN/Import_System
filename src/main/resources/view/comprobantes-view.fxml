<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.crudpersona.ui.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.crudpersona.controller.RPLCComprobantesController" spacing="16" prefWidth="1200" prefHeight="720" styleClass="view-root">
    <ResponsiveFlowPane alignment="CENTER_LEFT" styleClass="tarjeta, module-header">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <StackPane styleClass="header-icon"><FontIcon iconLiteral="fth-send" iconSize="20"/></StackPane>
        <VBox HBox.hgrow="ALWAYS" spacing="2">
            <Label text="Comprobantes SUNAT" styleClass="title-4"/>
            <Label text="Consulta emisión, estado, cliente y totales de boletas y facturas." styleClass="header-subtitle"/>
        </VBox>
        <TextField fx:id="txtBuscar" promptText="Buscar comprobante, cliente, documento o estado" prefWidth="310" onAction="#onBuscar"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="btn-secundario">
            <graphic><FontIcon iconLiteral="fth-search" iconSize="14"/></graphic>
        </Button>
        <Button text="Actualizar" onAction="#onActualizar" styleClass="btn-secundario">
            <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="14"/></graphic>
        </Button>
        <Button text="Guardar pendientes" onAction="#onGuardarPendientes" styleClass="btn-primario">
            <graphic><FontIcon iconLiteral="fth-send" iconSize="14"/></graphic>
        </Button>
    </ResponsiveFlowPane>
    <ResponsiveFlowPane alignment="CENTER_LEFT">
        <Label fx:id="lblResumen" text="Comprobantes" styleClass="text-subtle"/>
        <ExportarMenu fx:id="exportarReporte"/>
        <Button text="Ver / imprimir" onAction="#onVer" styleClass="btn-secundario"><graphic><FontIcon iconLiteral="fth-printer" iconSize="14"/></graphic></Button>
        <Button text="Descargar PDF" onAction="#onDescargarPdf" styleClass="btn-secundario"><graphic><FontIcon iconLiteral="fth-download" iconSize="14"/></graphic></Button>
        <Button text="Datos de empresa" onAction="#onDatosEmpresa" styleClass="btn-secundario"><graphic><FontIcon iconLiteral="fth-settings" iconSize="14"/></graphic></Button>
    </ResponsiveFlowPane>
    <TableView fx:id="tablaComprobantes" VBox.vgrow="ALWAYS" styleClass="tabla">
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90"/>
            <TableColumn fx:id="colSerie" text="Serie-Correlativo" prefWidth="130"/>
            <TableColumn fx:id="colDoc" text="Documento" prefWidth="140"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="250"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="110"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="160"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
