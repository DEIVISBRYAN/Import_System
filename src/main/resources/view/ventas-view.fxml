<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.crudpersona.ui.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.crudpersona.controller.DBQPVentasController" prefWidth="1280" prefHeight="720" styleClass="view-root">

    <VBox spacing="14" styleClass="tarjeta, module-header">
        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
        <ResponsiveFlowPane alignment="CENTER_LEFT">
            <StackPane styleClass="header-icon"><FontIcon iconLiteral="fth-file-text" iconSize="20"/></StackPane>
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Historial de ventas" styleClass="title-4"/>
                <Label text="Consulta ventas por cliente, DNI/RUC, comprobante, estado o fecha." styleClass="header-subtitle"/>
            </VBox>
            <Button text="Actualizar" onAction="#onActualizar" styleClass="btn-secundario">
                <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="14"/></graphic>
            </Button>
            <ExportarMenu fx:id="exportarReporte"/>
        </ResponsiveFlowPane>

        <ResponsiveFlowPane alignment="CENTER_LEFT" styleClass="action-strip">
            <TextField fx:id="txtBuscar" promptText="Cliente, DNI/RUC, comprobante o estado" HBox.hgrow="ALWAYS" onAction="#onFiltrar"/>
            <DatePicker fx:id="dpDesde" promptText="Desde" prefWidth="150"/>
            <DatePicker fx:id="dpHasta" promptText="Hasta" prefWidth="150"/>
            <Button text="Filtrar" onAction="#onFiltrar" styleClass="btn-primario">
                <graphic><FontIcon iconLiteral="fth-search" iconSize="14"/></graphic>
            </Button>
            <Button text="Limpiar" onAction="#onLimpiarFiltros" styleClass="btn-secundario"/>
        </ResponsiveFlowPane>
        <Label fx:id="lblResumenVentas" text="0 ventas" styleClass="text-subtle"/>
    </VBox>

    <ResponsiveSplitPane VBox.vgrow="ALWAYS">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colComprobante" text="Comprobante" prefWidth="140"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="230"/>
                    <TableColumn fx:id="colDocumento" text="DNI/RUC" prefWidth="130"/>
                    <TableColumn fx:id="colMetodoPago" text="Pago" prefWidth="110"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="165"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>

            <ResponsiveFlowPane alignment="CENTER_RIGHT">
                <Button text="Ver detalle" onAction="#onVerDetalle" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-eye" iconSize="14"/></graphic>
                </Button>
                <Button text="Reimprimir" onAction="#onReimprimir" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-printer" iconSize="14"/></graphic>
                </Button>
                <Button text="Anular y devolver stock" onAction="#onAnularVenta" styleClass="btn-secundario">
                    <graphic><FontIcon iconLiteral="fth-rotate-ccw" iconSize="14"/></graphic>
                </Button>
            </ResponsiveFlowPane>
        </VBox>

        <VBox spacing="14" prefWidth="390" styleClass="tarjeta, detail-panel">
            <Label text="Detalle de venta" styleClass="title-4"/>
            <GridPane hgap="10" vgap="8" styleClass="detail-grid">
                <Label text="Comprobante" styleClass="text-subtle" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblDetalleComprobante" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Cliente" styleClass="text-subtle" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblDetalleCliente" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Documento" styleClass="text-subtle" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="lblDetalleDocumento" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Fecha" styleClass="text-subtle" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="lblDetalleFecha" text="-" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <TableView fx:id="tablaDetalle" VBox.vgrow="ALWAYS" styleClass="tabla" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colDetProducto" text="Producto" prefWidth="190"/>
                    <TableColumn fx:id="colDetCantidad" text="Cant." prefWidth="65"/>
                    <TableColumn fx:id="colDetImporte" text="Importe" prefWidth="95"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>

            <VBox spacing="8" styleClass="total-panel">
                <HBox><Label text="Base" styleClass="text-subtle" HBox.hgrow="ALWAYS"/><Label fx:id="lblDetalleSubtotal" text="S/ 0.00"/></HBox>
                <HBox><Label text="IGV 18%" styleClass="text-subtle" HBox.hgrow="ALWAYS"/><Label fx:id="lblDetalleIgv" text="S/ 0.00"/></HBox>
                <Separator/>
                <HBox><Label text="Total" style="-fx-font-weight: bold;" HBox.hgrow="ALWAYS"/><Label fx:id="lblDetalleTotal" text="S/ 0.00" styleClass="money-value"/></HBox>
            </VBox>
        </VBox>
    </ResponsiveSplitPane>
</VBox>
